# Copy the values you need into .env.local. Do not commit real secrets.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=eduagent
DB_USER=eduagent_user
DB_PASSWORD=123456

MILVUS_HOST=localhost
MILVUS_PORT=19531

# Resume PDF persistence. Keep disabled when MinIO is not running.
OBJECT_STORAGE_ENABLED=true
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=pinda
MINIO_REGION=us-east-1

LANGGRAPH_CHECKPOINTER=memory
DEFAULT_TENANT_ID=tenant_default
JWT_SECRET_KEY=replace-with-a-long-random-secret

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_CHAT=deepseek-v4-flash
DEEPSEEK_MODEL_CODER=deepseek-v4-flash
